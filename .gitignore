gradle-app.setting

# Cache of project
.gradletasknamecache

**/build/

# Common working directory
run/
runs/

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!/gradle/wrapper/gradle-wrapper.jar

# Ignore node_modules directory
node_modules/

# Celular: videos originales que convierte tools/celular/convertir_videos.py
tools/celular/videos/

# Carpetas temporales de tools/celular/convertir_videos.py (se borran solas)
tools/celular/.conversion_*/
tools/celular/.respaldo_*/
# Python generator environments and bytecode
__pycache__/
*.py[cod]
.venv/
venv/

