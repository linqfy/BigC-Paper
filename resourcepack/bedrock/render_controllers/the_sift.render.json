{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.the_sift.default": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ]
    },
    "controller.render.the_sift.tamed": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "query.is_tamed ? Texture.tamed : Texture.default"
      ]
    }
  }
}
