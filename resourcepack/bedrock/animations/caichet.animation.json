{
  "format_version": "1.8.0",
  "animations": {
    "animation.caichet.boss_eye.idle": {
      "loop": true,
      "bones": {
        "body_pitch": {
          "rotation": [
            "query.target_x_rotation",
            0,
            0
          ]
        },
        "wing_l_anim": {
          "rotation": [
            0,
            0,
            "math.sin(query.anim_time * 515.7) * 32"
          ]
        },
        "wing_r_anim": {
          "rotation": [
            0,
            0,
            "-(math.sin(query.anim_time * 515.7) * 32)"
          ]
        }
      }
    },
    "animation.caichet.billboard": {
      "loop": true,
      "bones": {
        "billboard": {
          "rotation": [
            0,
            "query.camera_rotation(1) - query.body_y_rotation",
            0
          ]
        }
      }
    },
    "animation.caichet.dream_winged.flap": {
      "loop": true,
      "animation_length": 0.5,
      "bones": {
        "wing_up": {
          "scale": {
            "0": [
              1,
              1,
              1
            ],
            "0.2499": [
              1,
              1,
              1
            ],
            "0.25": [
              0,
              0,
              0
            ],
            "0.4999": [
              0,
              0,
              0
            ]
          }
        },
        "wing_down": {
          "scale": {
            "0": [
              0,
              0,
              0
            ],
            "0.2499": [
              0,
              0,
              0
            ],
            "0.25": [
              1,
              1,
              1
            ],
            "0.4999": [
              1,
              1,
              1
            ]
          }
        }
      }
    }
  }
}
